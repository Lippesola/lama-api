{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Pin Docker images to digest",
      "matchManagers": ["dockerfile", "docker-compose"],
      "pinDigests": true
    },
    {
      "description": "Automerge non-major npm and Dockerfile updates",
      "matchManagers": ["npm", "dockerfile"],
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "automerge": true,
      "ignoreTests": true
    },
    {
      "description": "Automerge docker-compose digest pins and digest updates",
      "matchManagers": ["docker-compose"],
      "matchUpdateTypes": ["pinDigest", "digest"],
      "automerge": true,
      "ignoreTests": true
    },
    {
      "description": "No version updates for docker-compose images, only digests",
      "matchManagers": ["docker-compose"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on monday"],
    "automerge": true,
    "ignoreTests": true
  },
  "vulnerabilityAlerts": {
    "description": "Raise security updates immediately; non-major ones are automerged by packageRules, major ones are not",
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "prCreation": "immediate"
  }
}
